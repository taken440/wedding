# ============================================================
# CLOUDFLARE R2 — https://dash.cloudflare.com/
# ============================================================
# 1. Create a bucket (e.g. "wedding-gallery")
# 2. Go to R2 → Manage R2 API Tokens → Create Token (Admin Read & Write)
# 3. Copy the Account ID from the R2 overview page
# 4. Set CORS on the bucket (Settings → CORS Policy):
#    [{"AllowedOrigins":["*"],"AllowedMethods":["PUT","GET"],"AllowedHeaders":["*"],"ExposeHeaders":["ETag"],"MaxAgeSeconds":3600}]

R2_ACCOUNT_ID=abc123def456ghi789
R2_ACCESS_KEY_ID=your_r2_access_key_id
R2_SECRET_ACCESS_KEY=your_r2_secret_access_key
R2_BUCKET_NAME=wedding-gallery

# ============================================================
# ADMIN AUTH
# ============================================================
# Strong admin password — change before deploying!
ADMIN_PASSWORD=change_me_strong_password_here

# Random 64-char hex string — run: openssl rand -hex 32
JWT_SECRET=change_me_64_char_hex_secret_here

# ============================================================
# WEDDING INFO (shown on the public page)
# ============================================================
NEXT_PUBLIC_BRIDE_NAME=Mia
NEXT_PUBLIC_GROOM_NAME=Jonas
NEXT_PUBLIC_WEDDING_DATE=2024 m. rugsėjo 14 d.

# ============================================================
# LIMITS
# ============================================================
# Max single file size in bytes (default 5GB)
MAX_FILE_SIZE_BYTES=5368709120

# Allowed MIME types (comma-separated, leave empty to allow all image/* and video/*)
# ALLOWED_MIME_TYPES=
