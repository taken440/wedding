# ==============================================================================
# CLOUDFLARE R2 STORAGE
# https://dash.cloudflare.com → R2 → Create bucket
# ==============================================================================

# Full endpoint URL: https://<ACCOUNT_ID>.r2.cloudflarestorage.com
R2_ENDPOINT=https://abc123def456ghi789.r2.cloudflarestorage.com

# Create an API token: R2 → Manage R2 API Tokens → Create Token (Admin Read & Write)
R2_ACCESS_KEY_ID=your_r2_access_key_id
R2_SECRET_ACCESS_KEY=your_r2_secret_access_key

R2_BUCKET_NAME=wedding-gallery

# Optional — only needed if you make the bucket public via R2 custom domain / r2.dev.
# Leave empty to keep the bucket private (admin views files via presigned URLs).
# R2_PUBLIC_BASE_URL=https://pub-xxx.r2.dev

# ------------------------------------------------------------------------------
# R2 CORS — set this in the bucket Settings → CORS Policy.
# Replace the origin with your exact Railway domain:
#
# [
#   {
#     "AllowedOrigins": ["https://wedding.up.railway.app"],
#     "AllowedMethods": ["PUT"],
#     "AllowedHeaders": ["Content-Type"],
#     "ExposeHeaders": ["ETag"],
#     "MaxAgeSeconds": 3600
#   }
# ]
# ------------------------------------------------------------------------------

# ==============================================================================
# ADMIN AUTHENTICATION
# ==============================================================================

# Minimum 12 characters. Use a password manager to generate a strong one.
ADMIN_PASSWORD=change_me_strong_password_here

# Minimum 32 characters. Generate with: openssl rand -hex 32
JWT_SECRET=change_me_run_openssl_rand_hex_32

# ==============================================================================
# APPLICATION
# ==============================================================================

# The exact public URL of your deployment — used for CSRF origin validation.
# No trailing slash. Must match the Origin header browsers send.
APP_ORIGIN=https://wedding.up.railway.app

# ==============================================================================
# UPSTASH REDIS — rate limiting (Redis-backed, survives restarts)
# https://console.upstash.com → Create Database → REST API
# Free tier: 10,000 requests/day — sufficient for a wedding.
# ==============================================================================
UPSTASH_REDIS_REST_URL=https://xxx.upstash.io
UPSTASH_REDIS_REST_TOKEN=your_upstash_token

# ==============================================================================
# WEDDING DETAILS (displayed on the public page)
# ==============================================================================
NEXT_PUBLIC_BRIDE_NAME=Mia
NEXT_PUBLIC_GROOM_NAME=Jonas
NEXT_PUBLIC_WEDDING_DATE=2024 m. rugsėjo 14 d.

# ==============================================================================
# LIMITS
# ==============================================================================
# Maximum single file size in bytes. Default: 5 GB.
MAX_FILE_SIZE_BYTES=5368709120

# Hard cap on total storage. Default: 50 GB. Set MAX_STORAGE_BYTES in Railway/Vercel.
# 50 GB=53687091200  100 GB=107374182400  200 GB=214748364800
MAX_STORAGE_BYTES=53687091200
